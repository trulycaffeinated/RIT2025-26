-- Jeff Taylor
-- LPF

library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;
use ieee.std_logic_signed.all;

entity audio_filter is
Port (
	clk, reset_n 	: in std_logic;
	write 			: in std_logic;
	address 			: in std_logic;
	writedata 		: in std_logic_vector(15 downto 0);
	--
	readdata 		:out std_logic_vector(15 downto 0)
);
end audio_filter;

architecture beh of audio_filter is 

type array_filt is array (0 to 16) of std_logic_vector(15 downto 0);
constant low_pass : array_filt := (
        0  => x"0052",  -- 0.0025 * 2^15
        1  => x"00BB",  -- 0.0057
        2  => x"01E2",  -- 0.0147
        3  => x"0408",  -- 0.0315
        4  => x"071B",  -- 0.0555
        5  => x"0AAD",  -- 0.0834
        6  => x"0E11",  -- 0.1099
        7  => x"1080",  -- 0.1289
        8  => x"1162",  -- 0.1358
        9  => x"1080",  -- 0.1289
        10 => x"0E11",  -- 0.1099
        11 => x"0AAD",  -- 0.0834
        12 => x"071B",  -- 0.0555
        13 => x"0408",  -- 0.0315
        14 => x"01E2",  -- 0.0147
        15 => x"00BB",  -- 0.0057
        16 => x"0052"   -- 0.0025
    );

constant high_pass : array_filt := (
        0  => x"003E",  -- 0.0025 * 2^15
        1  => x"FF9B",  -- 0.0057
        2  => x"FE9F",  -- 0.0147
        3  => x"0000",  -- 0.0315
        4  => x"0535",  -- 0.0555
        5  => x"05B2",  -- 0.0834
        6  => x"F5AC",  -- 0.1099
        7  => x"DAB7",  -- 0.1289
        8  => x"4C91",  -- 0.1358
        9  => x"DAB7",  -- 0.1289
        10 => x"F5AC",  -- 0.1099
        11 => x"05B3",  -- 0.0834
        12 => x"0536",  -- 0.0555
        13 => x"0000",  -- 0.0315
        14 => x"FE9F",  -- 0.0147
        15 => x"FF9B",  -- 0.0057
        16 => x"003F"   -- 0.0025
    );

signal sum : std_logic_vector(31 downto 0);
signal writedata_buffer : array_filt := (OTHERS => (OTHERS => '0'));
	
component mult is
	port(
		dataa : in std_logic_vector(15 downto 0);
		datab : in std_logic_vector(15 downto 0);
		result : out std_logic_vector(31 downto 0)
	);
end component mult;

--type mult_array is array (0 to 16) of signed(31 downto 0);
type mult_array is array (0 to 16) of std_logic_vector(31 downto 0); -- ACTUAL CODE
signal mult_results : mult_array;

signal filter_select : std_logic := '0';

type coeff_array  is array (0 to 16) of std_logic_vector(31 downto 0);
signal coefficients : coeff_array := (OTHERS => (OTHERS => '0'));

function coeff_mux(i : integer, filter_select : std_logic) return std_logic_vector is
begin
	if(filter_select = '1') then
		return high_pass(i);
	else
		return low_pass(i);
	end if;
end function;

begin

-- choose coefficients
process(clk, reset_n)
begin
	for i in 0 to 16 loop
		coefficients(i) <= signed(coeff_mux(i, select_filt));
	end loop;
end process;

mult_generation : for i in 0 to 16 generate
	mult_inst : mult PORT MAP (
		dataa	 => writedata_buffer(i),
		datab	 => coefficients(i),
		result	 => mult_results(i)
	);
end generate mult_generation;

process(clk, reset_n)
begin
	if(reset_n = '0') then
		select_filt <= '0';
	elsif rising_edge(clk) then
		if (write = '1') then
			case address is
				when '0' =>
					filter_en <= '1';
				when '1' =>
					select_filt <= writedata(0);
				when others
				-- boken;
			end case;
		end if;
	end if;
end process;

-- Fill up the input delay (will be passed to the multipler)
process(clk, reset_n)
begin
	if(reset_n = '0') then
		for i in 0 to 16 loop
			-- fill with zeros
			writedata_buffer(i) <= (OTHERS => '0');
		end loop;
	elsif(rising_edge(clk)) then
		if(filter_en = '1') then
			writedata_buffer(0) <= writedata;
			for i in 1 to 16 loop
				writedata_buffer(i) <= writedata_buffer(i - 1);
			end loop;
		end if;
	end if;
end process;

-- do the sum
process(clk, reset_n)
	variable sum_buffer : std_logic_vector(31 downto 0);
begin
	if(reset_n = '0') then
		sum <= (OTHERS => '0');
	elsif(rising_edge(clk)) then
		if(filter_en = '1') then
			sum_buffer := (OTHERS => '0');
			for i in 0 to 16 loop
				sum_buffer := sum_buffer + std_logic_vector(mult_results(i));
			end loop;
			sum <= sum_buffer;
		end if;
	end if;
end process;

-- data out
data_out <= sum(30 downto 15);

end architecture beh;