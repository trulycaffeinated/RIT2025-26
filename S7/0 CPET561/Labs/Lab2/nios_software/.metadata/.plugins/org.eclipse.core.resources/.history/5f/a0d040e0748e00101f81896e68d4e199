# ------------------------------
# Assembly language program that pushes a 0 to hex0
# PRELAB portion
# ------------------------------

.text

.macro MOVIA reg, addr
    movhi \reg, %hi(\addr)
    ori \reg, \reg, %lo(\addr)
.endm

# define constants
.equ HEX0, 0x11020
.equ KEY, 0x11010
.equ SW, 0x11000

.global main
main :
    movia r2, HEX0

	#load value - displays zero
	movia r3, hex_dig
	ldbio r4, 0(r3)
	stbio r4, 0(r2)

done:
	br done

.data
hex_dig:
	.byte 0x40, 0x79, 0x24, 0x30, 0x19, 0x12, 0x02, 0x78, 0x00, 0x10
