# ------------------------------
# Assembly language program that pushes a 0 to hex0
# PRELAB portion
# ------------------------------

.text

# define a macro to move a 32 bit address to a register

.macro MOVIA reg, addr
    movhi \reg, %hi(\addr)
    ori \reg, \reg, %lo(\addr)
.endm

# define constants
.equ HEX0, 0x3020
.equ PUSHBUTTONS, 0x3010
.equ SWITCHES, 0x3000
.equ DISPLAY0, 0x40

.global main
main :
    movia r2, DISPLAY0
    movia r3, HEX0

loop:
    ldbio r4, 0(r2)
    stbio r4, 0(r3)
    br loop
