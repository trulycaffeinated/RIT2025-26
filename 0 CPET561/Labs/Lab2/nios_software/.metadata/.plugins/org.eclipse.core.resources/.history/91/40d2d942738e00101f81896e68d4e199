# ------------------------------
# Assembly language program that pushes a 0 to hex0
# PRELAB portion
# ------------------------------

.text

# define a macro to move a 32 bit address to a register

.macro MOVIA reg, addr
    movhi \reg, %hi(\addr)
    ori \reg, \reg, %lo(\addr)
.endm

# define constants
.equ HEX0, 11020
.equ KEY, 0x11010
.equ SW, 0x11000

.global main
main :
    movia r2, HEX0

	#load value
	movia r3, hex_dig

hex_dig:
	.byte 0x40
