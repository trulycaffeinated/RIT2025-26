# ------------------------------
# Assembly language program that pushes a 0 to hex0
# PRELAB portion
# ------------------------------

.text

.macro MOVIA reg, addr
    movhi \reg, %hi(\addr)
    ori \reg, \reg, %lo(\addr)
.endm

# define constants
.equ HEX0, 0x11020
.equ KEY, 0x11010
.equ SW, 0x11000

.global main
main :
    movia r2, HEX0
    movia r3, KEY
    movia r4, SW

	#load value - displays zero
	movia r5, hex_dig
	ldbio r6, 0(r5)
	stbio r6, 0(r2)

wait_for_press:
	#read keys and load into r7
	ldbio r7, 0(r3)
	andi r8, r8, 0x02


done:
	br done

.data
hex_dig:
	.byte 0x40, 0x79, 0x24, 0x30, 0x19, 0x12, 0x02, 0x78, 0x00, 0x10
