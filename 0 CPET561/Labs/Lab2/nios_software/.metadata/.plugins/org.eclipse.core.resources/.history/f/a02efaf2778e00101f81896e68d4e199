# ------------------------------
# Assembly language program that pushes a 0 to hex0
# PRELAB portion
# ------------------------------

.text

.macro MOVIA reg, addr
    movhi \reg, %hi(\addr)
    ori \reg, \reg, %lo(\addr)
.endm

# define constants
.equ HEX0, 0x11020
.equ KEY, 0x11010
.equ SW, 0x11000

.global main
main :
    movia r2, HEX0
    movia r3, KEY
    movia r4, SW

	#load value - displays zero
	movia r5, hex_dig
	ldbio r6, 0(r5)
	stbio r6, 0(r2)

wait_for_press:
	#read keys and load into r7
	ldbio r7, 0(r3)
	#check r7 for any presses - mask against 0010
	andi r7, r7, 0x02
	bne r7, r0, wait_for_press
	beq r7, r0, wait_for_release

wait_for_release:
	#read keys and load into r7
	ldbio r7, 0(r3)
	#check for r7 for any releases - mask 0010
	andi r7, r7, 0x02
	beq r7, r0, wait_for_release
	bne r7, r0, sw_state_check

sw_state_check:
	#read switch state and load into r9
	ldbio r9, 0(r4)
	#check r9 for current state
	andi r9, r9, 0x01
	bne r9, r0, decr
	beq r9, r9, incr

incr:
	ldbio r6, 0(r5)
	br wait_for_press

decr:
	ldbio r6, 0(r5)
	br wait_for_press

hex:
	#br

.data
hex_dig:
	.byte 0x40, 0x79, 0x24, 0x30, 0x19, 0x12, 0x02, 0x78, 0x00, 0x10
const_one:
	.byte 0xFF
